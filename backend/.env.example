# ─── Core ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Public-facing URL of the frontend (used in emails, sitemap, OAuth-like flows)
PUBLIC_APP_URL=http://localhost:5173

# CORS allow-list (comma-separated origins for frontend)
CLIENT_URL=http://localhost:5173

# ─── Database ────────────────────────────────────────────────────────────────
# Local: mongodb://127.0.0.1:27017/confer
# Atlas: mongodb+srv://<user>:<pw>@<cluster>/confer?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/confer

# ─── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -hex 64
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ─── Payments (Razorpay) ────────────────────────────────────────────────────
# Leave blank for mock mode (auto-completes in dev). For production, set both.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional separate webhook secret (falls back to RAZORPAY_KEY_SECRET if blank)
RAZORPAY_WEBHOOK_SECRET=

# ─── Email service ───────────────────────────────────────────────────────────
# Adapter: console (default, dev), smtp, noop
EMAIL_PROVIDER=console
EMAIL_FROM=Confer <no-reply@confer.app>

# SMTP settings (only required when EMAIL_PROVIDER=smtp)
# For Resend: smtp.resend.com / 587 / resend / <api-key>
# For SendGrid: smtp.sendgrid.net / 587 / apikey / <api-key>
# For Gmail: smtp.gmail.com / 587 / <gmail> / <app-password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ─── File storage ────────────────────────────────────────────────────────────
# Adapter: local (default, writes to ./uploads), cloudinary
STORAGE_PROVIDER=local
UPLOAD_ROOT=./uploads

# Cloudinary (only required when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
